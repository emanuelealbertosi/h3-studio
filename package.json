{
  "name": "h3-studio",
  "version": "0.2.0",
  "description": "Local-first MiniMax H3 production studio for ComfyUI",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/emanuelealbertosi/h3-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emanuelealbertosi/h3-studio.git"
  },
  "bugs": {
    "url": "https://github.com/emanuelealbertosi/h3-studio/issues"
  },
  "private": true,
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:bridge": "tsx watch bridge/server.ts",
    "start:bridge": "tsx bridge/server.ts",
    "import:history": "tsx scripts/import-studio-history.ts",
    "test:projects": "tsx scripts/test-project-repository.ts",
    "test:export": "tsx scripts/test-timeline-export.ts",
    "test:library": "tsx scripts/test-creative-library.ts",
    "test:external": "tsx scripts/test-external-media.ts",
    "test:krea-contract": "tsx scripts/test-krea-contract.ts",
    "test:images": "tsx scripts/test-image-studio.ts",
    "test:chat": "tsx scripts/test-chat.ts",
    "test:audio": "tsx scripts/test-audio-studio.ts",
    "test:ltx25": "tsx scripts/test-ltx25.ts",
    "test:multishot": "python scripts/test-multishot-scheduling.py",
    "test:continuation": "node scripts/test-continuation-boundary.mjs",
    "test:composer": "python scripts/test-composer-json-repair.py",
    "test:cancel": "tsx scripts/test-comfy-cancel.ts",
    "test:admission": "tsx scripts/test-comfy-admission.ts",
    "catalog:loras": "tsx scripts/scan-lora-catalog.ts",
    "test:restart": "node scripts/test-bridge-restart.mjs",
    "test:preview-layout": "node scripts/test-preview-layout.mjs",
    "test:postprocess": "tsx scripts/test-postprocess-variants.ts",
    "test:repair-processing-times": "tsx scripts/test-repair-processing-times.ts",
    "test:setup": "tsx scripts/test-setup-auth.ts",
    "test:llm-runtime": "tsx scripts/test-llm-runtime.ts",
    "test:llm-provider": "tsx scripts/test-llm-provider.ts",
    "test:sam-runtime": "tsx scripts/test-sam-runtime.ts",
    "test:masking": "tsx scripts/test-masking.ts",
    "repair:processing-times": "tsx scripts/repair-processing-times.ts",
    "setup:audio-voice": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-audio-cpp-voice.ps1",
    "sanitize:workflows": "tsx scripts/sanitize-bundled-workflows.ts",
    "typecheck": "tsc --noEmit --pretty false",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/websocket": "11.3.0",
    "fastify": "5.12.1",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
