NEXT_PUBLIC_H3_BRIDGE_URL=http://localhost:8787
H3_BRIDGE_HOST=127.0.0.1
H3_BRIDGE_PORT=8787
# Per accesso LAN esplicito usare H3_WEB_HOST=0.0.0.0 e
# H3_BRIDGE_HOST=0.0.0.0, poi aggiungere gli URL consentiti a H3_WEB_ORIGINS.
H3_WEB_HOST=127.0.0.1
H3_COMFY_URL=http://127.0.0.1:9000
# Al primo avvio questi valori vengono salvati in data/install-settings.json.
# H3_COMFY_OUTPUT_DIR=C:\ComfyUI\output
H3_COMFY_TIMEOUT_MS=3000
H3_WORKFLOW_OUTPUT_DIR=./workflows
H3_DATA_DIR=./data
H3_FFMPEG_PATH=ffmpeg
H3_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
